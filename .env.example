# Aplicação
APP_ENV=development
LOG_LEVEL=INFO

# Portas e bind
# Administração deve permanecer em um endereço de loopback.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8081
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8080

# Segredos de sessão (gere valores distintos, com pelo menos 32 caracteres)
# Exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY_ADMIN=
SECRET_KEY_VIEWER=

# Sessão
SESSION_TIMEOUT_MINUTES=60
ADMIN_SESSION_TIMEOUT_MINUTES=30

# Banco
DATABASE_PATH=config/database.db

# Telegram (conta dedicada) — usado a partir da fase 2
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=config/telegram.session
TELEGRAM_CHANNEL_ID=

# Mídia — usado a partir da fase 5
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CACHE_DIR=cache
CACHE_MAX_GB=20
CACHE_TTL_HOURS=168

# Rede — decidido na fase 9
TUNNEL_MODE=none
PUBLIC_BASE_URL=
