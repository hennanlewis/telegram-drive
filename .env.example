# Aplicação
APP_ENV=development
LOG_LEVEL=INFO

# Portas e bind
# Administração deve permanecer em localhost.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8081
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8080

# Segredos de sessão (gere valores distintos)
SECRET_KEY_ADMIN=
SECRET_KEY_VIEWER=

# Banco
DATABASE_PATH=config/database.db

# Telegram (conta dedicada)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=config/telegram.session
TELEGRAM_CHANNEL_ID=

# Mídia
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CACHE_DIR=cache
CACHE_MAX_GB=20
CACHE_TTL_HOURS=168

# Rede (decidir na fase 09)
TUNNEL_MODE=none
PUBLIC_BASE_URL=
